            "type": "object",
            "required": [
              "sources",
              "inspection_number"
            ],
            "properties": {
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "inspection_number": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "runtime_version": 1,
          "timeout_seconds": 5
        },
        "type_version": 1,
        "input_mapping": {
