        "id": "filter_files",
        "ui": {
          "x": 820,
          "y": 160
        },
        "name": "纸浆 · 筛选文件",
        "type": "data.python",
        "config": {
          "code": "import re\nimport unicodedata\ndef main(inputs):\n    if inputs['truncated']:\n        raise ValueError('文件超过查询上限，请缩小目录范围后重新查询')\n    number = unicodedata.normalize('NFKC', inputs['inspection_number']).strip().upper()\n    rules = inputs['rules']\n    expression = r'(?<![A-Z0-9])' + re.escape(number) + r'(?![A-Z0-9])'\n    items = []\n    for item in inputs['items']:\n        path = unicodedata.normalize('NFKC', item['relative_path']).replace('\\\\', '/').upper()\n        if not re.search(expression, path):\n            continue\n        if any(word.upper() in path for word in rules['exclude_words']):\n            continue\n        items.append(item)\n    if not items:\n        raise ValueError('目录中没有匹配该编号的 Excel；请核对目录与文件索引')\n    return {'sources': items, 'inspection_number': number}\n",
          "input_schema": {
            "type": "object",
            "required": [
              "inspection_number",
              "items",
              "truncated",
              "rules"
            ],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "rules": {
                "type": "object",
                "required": [
                  "exclude_words"
                ],
                "properties": {
                  "exclude_words": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "truncated": {
