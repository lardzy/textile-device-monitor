# bridge.env 模板。安装后复制为 config\bridge.env 并填写；该文件含机密，
# 务必保持 NTFS ACL 仅管理员/SYSTEM 可读，不得提交 Git、不得外发。
#
# 执行系统桥令牌：必须与后端环境变量 EXECUTION_BRIDGE_TOKEN 完全一致。
EXECUTION_BRIDGE_TOKEN=
#
# 旧检务系统账号（该账号的显示名将作为上传人/复核人写入旧系统）。
LEGACY_FIBRECHECK_LOGIN=
LEGACY_FIBRECHECK_PASSWORD=
#
# 文件服务器 SMB 凭据（\\192.168.105.82\fibrecheckfile$ 与 材料检测中心 共享）。
SMB_USER_B=
SMB_PASS_B=
