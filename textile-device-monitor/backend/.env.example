# Local backend/Vite development only. Production uses the repository-level
# .env and docker-compose.yml. Generate independent random secrets rather than
# copying values between the three fields below.
APP_ENV=development
DATABASE_URL=sqlite:///./runtime/textile-monitor-dev.db
SECRET_KEY=
HEARTBEAT_TIMEOUT=90
DATA_RETENTION_DAYS=30
STATUS_REPORT_RETENTION_HOURS=48
CORS_ORIGINS=http://127.0.0.1:3100,http://localhost:3100

# HTTP is the default for local development and LAN trial deployments.
# Set WEB_TRANSPORT=https and provide the TLS values below when HTTPS is needed.
WEB_TRANSPORT=http
PUBLIC_HOSTNAME=localhost
PUBLIC_ORIGIN=http://localhost
TLS_DIR_HOST_PATH=
TLS_MIN_VALID_DAYS=30
HSTS_MAX_AGE=0
MANAGEMENT_CIDRS=

# Execution system
EXECUTION_ENABLED=true
# Generate with `openssl rand -base64 48`.
EXECUTION_SESSION_SECRET=
EXECUTION_SESSION_TTL_HOURS=12
EXECUTION_COOKIE_SECURE=false
# Optional one-time bootstrap. Prefer the CLI and remove these values after use.
EXECUTION_BOOTSTRAP_ADMIN_USERNAME=
EXECUTION_BOOTSTRAP_ADMIN_PASSWORD=
# Required in production for external-system credential encryption.
EXECUTION_CREDENTIAL_KEY=
EXECUTION_SOURCE_ROOT=./runtime/execution-input
EXECUTION_RUNTIME_ROOT=./runtime/execution-runtime
EXECUTION_PUBLISH_ROOT=./runtime/execution-publish
EXECUTION_INDEX_INTERVAL_SECONDS=300
EXECUTION_WORKER_POLL_SECONDS=1
EXECUTION_WORKER_LEASE_SECONDS=60
EXECUTION_NODE_MAX_ATTEMPTS=5
EXECUTION_WORKER_HEARTBEAT_TIMEOUT_SECONDS=45
EXECUTION_WORKER_SCHEMA_WAIT_SECONDS=180
EXECUTION_OUTBOX_MAX_ATTEMPTS=10
EXECUTION_OUTBOX_RETENTION_DAYS=7
EXECUTION_SSE_MAX_SECONDS=300
EXECUTION_EXTERNAL_PREFLIGHT_TTL_MINUTES=30
EXECUTION_EXTERNAL_APPROVAL_TTL_MINUTES=15
# Shared secret for the external-operation Bridge client, sent as the
# X-Execution-Bridge-Key header. Both this and the explicit switch are needed.
EXECUTION_BRIDGE_ENABLED=false
EXECUTION_BRIDGE_TOKEN=
