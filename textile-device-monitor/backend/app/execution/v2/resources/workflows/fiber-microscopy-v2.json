              "images",
              "form",
              "rules",
              "templates"
            ],
            "additionalProperties": false
          },
          "output_schema": {
            "type": "object",
            "properties": {
              "inspection_number": {
                "type": "string"
              },
              "project": {
                "type": "object",
                "additionalProperties": true
              },
              "values": {
                "type": "object",
                "additionalProperties": true
              },
              "images": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "artifact": {
                      "type": "object",
                      "properties": {
                        "root_id": {
                          "type": "string"
                        },
                        "relative_path": {
                          "type": "string"
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "id": {
                          "type": "string"
                        },
                        "fingerprint": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "root_id",
                        "relative_path"
                      ],
                      "additionalProperties": false,
                      "anyOf": [
                        {
                          "required": [
                            "sha256"
                          ]
                        },
                        {
                          "required": [
                            "fingerprint"
                          ]
                        }
                      ]
                    },
                    "sheet": {
                      "type": "string"
                    },
