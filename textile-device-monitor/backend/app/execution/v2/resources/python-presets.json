[
  {
    "id": "filter_files",
    "name": "纸浆 · 筛选文件",
    "config": {
      "runtime_version": 1,
      "timeout_seconds": 5,
      "code": "import re\nimport unicodedata\ndef main(inputs):\n    number = unicodedata.normalize('NFKC', inputs['inspection_number']).strip().upper()\n    rules = inputs['rules']\n    expression = r'(?<![A-Z0-9])' + re.escape(number) + r'(?![A-Z0-9])'\n    items = []\n    for item in inputs['items']:\n        path = unicodedata.normalize('NFKC', item['relative_path']).replace('\\\\', '/').upper()\n        if not re.search(expression, path):\n            continue\n        if any(word.upper() in path for word in rules['exclude_words']):\n            continue\n        items.append(item)\n    if not items:\n        raise ValueError('目录中没有匹配该编号的 Excel；请核对目录与文件索引')\n    return {'sources': items, 'inspection_number': number}\n",
      "input_schema": {
        "type": "object",
        "properties": {
          "inspection_number": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "rules": {
            "type": "object",
            "properties": {
              "exclude_words": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "exclude_words"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "inspection_number",
          "items",
          "rules"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "inspection_number": {
            "type": "string"
          }
        },
        "required": [
          "sources",
          "inspection_number"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "id": "candidates",
    "name": "纸浆 · 整理候选",
    "config": {
      "runtime_version": 1,
      "timeout_seconds": 5,
      "code": "import re\nimport unicodedata\ndef clean(value):\n    return unicodedata.normalize('NFKC', str(value if value is not None else '')).strip()\ndef main(inputs):\n    rules = inputs['rules']\n    projects = [p for p in inputs['snapshot']['projects']\n                if clean(p['check_item_name']) in rules['project_names']\n                and (not rules['methods'] or clean(p['check_method']) in rules['methods'])]\n    if not projects:\n        raise ValueError('检务任务没有符合配置的检测项目，请检查项目名称和方法规则')\n    items, errors = [], []\n    for row in inputs['rows']:\n        if row['read_status'] != 'succeeded':\n            errors.append({'source': row['source'], 'errors': row['errors']})\n            continue\n        result = clean(row['values'].get('result'))\n        if not result:\n            errors.append({'source': row['source'], 'errors': ['结果字段为空']})\n            continue\n        unit = rules['percent_unit'] if re.search(rules['percent_pattern'], result) else ''\n        for project in projects:\n            file = row['file']\n            items.append({'id': file['id'] + ':' + project['project_key'], 'kind':'artifact',\n                'label': file['label'] + ' · ' + project['check_item_name'] + ' · ' + result,\n                'root_id':row['source']['root_id'], 'relative_path':row['source']['relative_path'],\n                'fingerprint':row['sha256'], 'items':[file], 'metadata':{'project':project,'source':row['source'],\n                    'sha256':row['sha256'], 'format':row['format'], 'raw_values':row['values'],\n                    'result':result,'standard':clean(row['values'].get('standard')),'unit':unit}})\n    if not items:\n        raise ValueError('没有可用的非空工作簿结果；读取错误：' + str(errors))\n    return {'items':items,'read_errors':errors}\n",
      "input_schema": {
        "type": "object",
        "properties": {
          "snapshot": {
            "type": "object",
            "additionalProperties": true
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "rules": {
            "type": "object",
            "properties": {
              "project_names": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "methods": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "percent_pattern": {
                "type": "string"
              },
              "percent_unit": {
                "type": "string"
              }
            },
            "required": [
              "project_names",
              "methods",
              "percent_pattern",
              "percent_unit"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "snapshot",
          "rows",
          "rules"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "artifact",
                    "image"
                  ]
                },
                "label": {
                  "type": "string"
                },
                "root_id": {
                  "type": "string"
                },
                "relative_path": {
                  "type": "string"
                },
                "fingerprint": {
                  "type": "string"
                },
                "metadata": {
                  "type": "object",
                  "additionalProperties": true
                },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "artifact",
                          "image"
                        ]
                      },
                      "label": {
                        "type": "string"
                      },
                      "root_id": {
                        "type": "string"
                      },
                      "relative_path": {
                        "type": "string"
                      },
                      "fingerprint": {
                        "type": "string"
                      },
                      "metadata": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "required": [
                      "id",
                      "kind",
                      "label",
                      "fingerprint"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "kind",
                "label",
                "fingerprint"
              ],
              "additionalProperties": false
            }
          },
          "read_errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "required": [
          "items",
          "read_errors"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "id": "prepare_form",
    "name": "纸浆 · 准备必要输入",
    "config": {
      "runtime_version": 1,
      "timeout_seconds": 5,
      "code": "import re\nimport unicodedata\ndef main(inputs):\n    project = inputs['selected']['metadata']['project']\n    raw = unicodedata.normalize('NFKC', str(project.get('sample_identify') or '')).strip()\n    choices = list(dict.fromkeys([x.strip() for x in re.split(inputs['rules']['identity_separator'],raw) if x.strip()]))\n    fields = {'sample_identity':{'type':'string','title':'样品标识'},\n              'judge_basis':{'type':'string','title':'判定依据'},\n              'judgement':{'type':'string','title':'判定结果'},\n              'standard_value':{'type':'string','title':'标准值'}}\n    defaults = dict.fromkeys(fields,'')\n    if len(choices) == 1:\n        defaults['sample_identity'] = choices[0]\n    if choices:\n        fields['sample_identity']['enum'] = choices\n    if len(choices) > 1 or project['check_count'] > 1:\n        fields['sample_identity']['minLength'] = 1\n    if project.get('give_judgement'):\n        for key in ('judge_basis','judgement','standard_value'):\n            fields[key]['minLength'] = 1\n        defaults['standard_value'] = inputs['selected']['metadata']['standard']\n        fields['judgement']['enum'] = inputs['rules']['judgements']\n    return {'form_schema':{'type':'object','properties':fields,'required':list(fields),'additionalProperties':False},\n            'defaults':defaults,'context':{'选择的记录':inputs['selected']['label'], '原始结果':inputs['selected']['metadata']['result']}}\n",
      "input_schema": {
        "type": "object",
        "properties": {
          "selected": {
            "type": "object",
            "additionalProperties": true
          },
          "rules": {
            "type": "object",
            "properties": {
              "identity_separator": {
                "type": "string"
              },
              "judgements": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "identity_separator",
              "judgements"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "selected",
          "rules"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "form_schema": {
            "type": "object",
            "additionalProperties": true
          },
          "defaults": {
            "type": "object",
            "properties": {
              "sample_identity": {
                "type": "string",
                "title": "样品标识"
              },
              "judge_basis": {
                "type": "string",
                "title": "判定依据"
              },
              "judgement": {
                "type": "string",
                "title": "判定结果"
              },
              "standard_value": {
                "type": "string",
                "title": "标准值"
              }
            },
            "required": [
              "sample_identity",
              "judge_basis",
              "judgement",
              "standard_value"
            ],
            "additionalProperties": false
          },
          "context": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "form_schema",
          "defaults",
          "context"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "id": "registration",
    "name": "纸浆 · 组装登记数据",
    "config": {
      "runtime_version": 1,
      "timeout_seconds": 5,
      "code": "def main(inputs):\n    data = inputs['selected']['metadata']\n    project, form = data['project'], inputs['form']\n    if project.get('give_judgement') and not all(form[key].strip() for key in ('judge_basis','judgement','standard_value')):\n        raise ValueError('本项目要求判定，请补充依据、结果和标准值')\n    header = dict.fromkeys(('grade','unit','judge_basis','test_method','sample_description','standard_type','report_check_item_name','attach_info','remark','total_judge'),'')\n    header.update(unit=data['unit'], test_method=project['check_method'],sample_description=form['sample_identity'])\n    if project.get('give_judgement'):\n        header.update(judge_basis=form['judge_basis'],total_judge=form['judgement'])\n    detail = {'standard_location':'','standard_value':form['standard_value'] if project.get('give_judgement') else '', 'real_location':'','real_value':data['result']}\n    keys = ('project_key','task_check_item_id','check_item_id','check_item_no','check_item_name','check_method','seq_num','check_count')\n    return {'inspection_number':inputs['inspection_number'],'project':{key:project[key] for key in keys},\n            'source':data['source'],'sha256':data['sha256'],'business_fields':inputs['business_fields'],\n            'expected_existing_register_count':project['register_count'], 'record':{'header':header,'details':[detail]}}\n",
