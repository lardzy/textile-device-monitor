        "receipt": "none",
        "unknown_outcome": "fail"
      },
      "policies": {
        "retry": {
          "mode": "fixed_engine"
        },
        "timeout": {
          "mode": "fixed_engine"
        },
        "error": {
          "default_action": "fail_run"
