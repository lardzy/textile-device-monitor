# Production Compose settings. Copy this file to .env, fill every required
# value, and keep .env outside Git. Blank required values intentionally make
# `docker compose config` fail before any container starts.
APP_ENV=production

# PostgreSQL. DATABASE_URL must contain the same account; URL-encode special
# characters in the password.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# Generate three independent values, for example with:
#   openssl rand -base64 48
SECRET_KEY=
EXECUTION_SESSION_SECRET=
EXECUTION_CREDENTIAL_KEY=

# Default HTTP entry point for development and department trial runs. Browsers
# and Windows clients can connect directly to http://<server LAN IP> without
# DNS, hosts entries or certificates.
WEB_TRANSPORT=http
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_HTTP_PORT=80
# Replace localhost with the Docker server's LAN IPv4 when other computers
# need to access the service. Include FRONTEND_HTTP_PORT in PUBLIC_ORIGIN when
# it is not 80.
PUBLIC_HOSTNAME=localhost
PUBLIC_ORIGIN=http://localhost
EXECUTION_COOKIE_SECURE=false
# Optional comma-separated private networks. Leave blank during trial runs to
# allow every address that can reach FRONTEND_BIND_ADDRESS.
MANAGEMENT_CIDRS=
HSTS_MAX_AGE=0

# Optional HTTPS only. These values are used when docker-compose.https.yml is
# included. See docs/internal-ca-operations.md.
FRONTEND_HTTPS_PORT=443
TLS_DIR_HOST_PATH=
TLS_MIN_VALID_DAYS=30

# Fixed internal proxy address. Uvicorn trusts forwarded headers only from this
# Nginx container address; change both values together and run preflight.
DOCKER_SUBNET=172.30.0.0/24
FRONTEND_PROXY_IP=172.30.0.10

# Same-origin browser access needs no CORS entries. If a separate origin is
# unavoidable, list exact HTTP or HTTPS origins separated by commas.
CORS_ORIGINS=

# Existing SMB volumes. SMB_USER_B/SMB_PASS_B are also used by the execution
# system to mount //192.168.105.82/材料检测中心 read-only at
# /data/execution-source. Keep real credentials only in Git-ignored local env
# files.
SMB_USER_A=
SMB_PASS_A=
SMB_USER_B=
SMB_PASS_B=

# Host resources. Relative defaults are portable; set absolute paths in the
# local .env when deployment data lives elsewhere.
AREA_MODEL_HOST_PATH=./runtime/area-models
AREA_TEMPLATE_HOST_PATH=./runtime/area-templates

# area_out_cifs exposes //192.168.105.82/材料检测中心 at
# /data/execution-source. This root points at the directory that directly
# contains 2026-特种毛, 2026-再生纤, 2026-麻棉 and 2026-电镜.
EXECUTION_SOURCE_ROOT=/data/execution-source/10特纤/02-检验
EXECUTION_RUNTIME_HOST_PATH=./runtime/execution-runtime
EXECUTION_PUBLISH_HOST_PATH=./runtime/execution-publish

EXECUTION_ENABLED=true
EXECUTION_INDEX_INTERVAL_SECONDS=300
# Only these roots are refreshed by the background worker. Other roots remain
# available through the manual refresh API.
EXECUTION_AUTO_INDEX_ROOT_IDS=regenerated_fiber_records
EXECUTION_WORKER_POLL_SECONDS=1
EXECUTION_WORKER_LEASE_SECONDS=60
EXECUTION_NODE_MAX_ATTEMPTS=5
EXECUTION_WORKER_HEARTBEAT_TIMEOUT_SECONDS=45
EXECUTION_WORKER_SCHEMA_WAIT_SECONDS=180
EXECUTION_OUTBOX_MAX_ATTEMPTS=10
EXECUTION_OUTBOX_RETENTION_DAYS=7
EXECUTION_SSE_MAX_SECONDS=300

# Optional one-time initial administrator. Remove both values after the first
# successful login; no built-in default password is provided.
EXECUTION_BOOTSTRAP_ADMIN_USERNAME=
EXECUTION_BOOTSTRAP_ADMIN_PASSWORD=
