# Production Compose settings. Copy this file to .env, fill every required
# value, and keep .env outside Git. Blank required values intentionally make
# `docker compose config` fail before any container starts.
APP_ENV=production

# PostgreSQL. DATABASE_URL must contain the same account; URL-encode special
# characters in the password.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# Generate three independent values, for example with:
#   openssl rand -base64 48
SECRET_KEY=
EXECUTION_SESSION_SECRET=
EXECUTION_CREDENTIAL_KEY=

# HTTPS entry point and management-network restriction.
# No company DNS change is required: department endpoint scripts map this
# hostname to the server's current LAN IP in each endpoint's local hosts file.
# Use the department server's current RFC1918 LAN IPv4. This only narrows the
# Docker port binding; it does not modify the NIC, DHCP or corporate network.
FRONTEND_BIND_ADDRESS=
FRONTEND_HTTPS_PORT=443
PUBLIC_HOSTNAME=textile-monitor.internal
PUBLIC_ORIGIN=https://textile-monitor.internal
# No corporate DNS change is required: managed terminal scripts install a
# local hosts mapping from this name to the department server's current LAN IP.
# Comma-separated private networks allowed to open the web UI. Without a
# department-only subnet, prefer the 20+ approved endpoint addresses as /32
# entries; do not copy a broad company-wide subnet merely for convenience.
# Mirror the verified endpoint allow-list in the department server's local
# Windows Firewall. Neither setting changes corporate network infrastructure.
MANAGEMENT_CIDRS=
# This repository-external directory must contain fullchain.pem, privkey.pem
# and root-ca.pem; it must never contain a CA private key.
TLS_DIR_HOST_PATH=
TLS_MIN_VALID_DAYS=30
# Start with 300 during the first grey release, then raise per the rollout plan.
HSTS_MAX_AGE=300

# Fixed internal proxy address. Uvicorn trusts forwarded headers only from this
# Nginx container address; change both values together and run preflight.
DOCKER_SUBNET=172.30.0.0/24
FRONTEND_PROXY_IP=172.30.0.10

# Same-origin browser access needs no CORS entries. If a separate HTTPS origin
# is unavoidable, list exact origins separated by commas; wildcard/HTTP values
# are rejected in production.
CORS_ORIGINS=

# Existing SMB volumes used by Area recognition.
SMB_USER_A=
SMB_PASS_A=
SMB_USER_B=
SMB_PASS_B=

# Host resources. Relative defaults are portable; set absolute paths in the
# local .env when deployment data lives elsewhere.
AREA_MODEL_HOST_PATH=./runtime/area-models
AREA_TEMPLATE_HOST_PATH=./runtime/area-templates

# This source mount contains 2026-特种毛, 2026-再生纤, 2026-麻棉 and 2026-电镜.
# Mount smb://192.168.105.82/... on the Docker host first; workflows receive
# only root IDs and relative paths, never the SMB URI.
EXECUTION_SOURCE_HOST_PATH=./runtime/execution-input
EXECUTION_RUNTIME_HOST_PATH=./runtime/execution-runtime
EXECUTION_PUBLISH_HOST_PATH=./runtime/execution-publish

EXECUTION_ENABLED=true
EXECUTION_INDEX_INTERVAL_SECONDS=300
EXECUTION_WORKER_POLL_SECONDS=1
EXECUTION_WORKER_LEASE_SECONDS=60
EXECUTION_NODE_MAX_ATTEMPTS=5
EXECUTION_WORKER_HEARTBEAT_TIMEOUT_SECONDS=45
EXECUTION_WORKER_SCHEMA_WAIT_SECONDS=180
EXECUTION_OUTBOX_MAX_ATTEMPTS=10
EXECUTION_OUTBOX_RETENTION_DAYS=7
EXECUTION_SSE_MAX_SECONDS=300

# Optional one-time initial administrator. Remove both values after the first
# successful login; no built-in default password is provided.
EXECUTION_BOOTSTRAP_ADMIN_USERNAME=
EXECUTION_BOOTSTRAP_ADMIN_PASSWORD=
