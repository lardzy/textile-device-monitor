# 生产环境 .env 模板（Win10 64 位 Docker 主机，仅 HTTP）。
# 使用方法：复制为 .env 放在仓库根 textile-device-monitor/ 下，逐项填写；
# 本文件不含也不允许提交真实凭据。字段说明见 12_生产部署方案.md 第 3 节。

APP_ENV=production
WEB_TRANSPORT=http
PUBLIC_HOSTNAME=<主机IP或主机名>
PUBLIC_ORIGIN=http://<主机IP或主机名>
EXECUTION_COOKIE_SECURE=false          # HTTP 下必须 false
FRONTEND_HTTP_PORT=80

POSTGRES_DB=textile_monitor
POSTGRES_USER=textile_prod
POSTGRES_PASSWORD=<强口令>
DATABASE_URL=postgresql://textile_prod:<强口令>@postgres:5432/textile_monitor
POSTGRES_DATA_HOST_PATH=D:/textile-monitor/postgres-data

SECRET_KEY=<随机 48 字节 base64>
EXECUTION_SESSION_SECRET=<随机 48 字节 base64>
# 随机生成后永久固定；变更会使已存旧系统凭据不可读
EXECUTION_CREDENTIAL_KEY=<随机 48 字节 base64>

EXECUTION_BRIDGE_ENABLED=true
EXECUTION_BRIDGE_TOKEN=<与桥机 config\bridge.env 中 BRIDGE_TOKEN 相同>
EXECUTION_LEGACY_SPECIAL_WOOL_WRITE_ENABLED=true
EXECUTION_LEGACY_MICROSCOPY_FINAL_ENTRY_ENABLED=true

# 宋体：微观形貌/横截面原始记录生成必须（目录内含 simsun.ttc）
EXECUTION_FONTS_HOST_PATH=D:/textile-monitor/fonts
EXECUTION_RUNTIME_HOST_PATH=D:/textile-monitor/runtime/execution-runtime
EXECUTION_PUBLISH_HOST_PATH=D:/textile-monitor/runtime/execution-publish
# 面积识别（高频功能）模型权重与 Excel 模板：指向旧部署的真实目录，
# 或把旧部署 area-models/area-templates 内容复制到下面两个目录
AREA_MODEL_HOST_PATH=D:/textile-monitor/runtime/area-models
AREA_TEMPLATE_HOST_PATH=D:/textile-monitor/runtime/area-templates

SMB_USER_A=<192.168.105.66 共享账号>
SMB_PASS_A=<密码>
SMB_USER_B=<192.168.105.82 共享账号>
SMB_PASS_B=<密码>

# 仅首次引导使用：创建管理员后立即删除这两行并重启 backend/worker
# EXECUTION_BOOTSTRAP_ADMIN_USERNAME=admin
# EXECUTION_BOOTSTRAP_ADMIN_PASSWORD=<强口令>
